# ==============================================================================
# Orvane Works — Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local`: `cp .env.example .env.local`
# 2. Fill in all values before launching the application.
# 3. NEVER commit `.env.local` or production API keys to Git.
# ==============================================================================

# ── Studio Admin Bootstrap ────────────────────────────────────────────────────
# The email of the founding administrator. Used by scripts/create-admin.ts
ADMIN_EMAIL=

# ── Supabase Configuration ───────────────────────────────────────────────────
# Found in Supabase Dashboard -> Project Settings -> API
# Public Project URL (e.g. https://xyzcompany.supabase.co or http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=

# Public Anon Client Key (Safe for browser / client-side queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-Only Service Role Key (NEVER expose to browser; bypasses RLS for admin scripts)
SUPABASE_SERVICE_ROLE_KEY=

# ── Transactional Email (Resend) ─────────────────────────────────────────────
# Resend API Key from https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender email formatted as: "Orvane Works <hello@yourdomain.com>"
EMAIL_FROM=

# Central studio email inbox where new contact briefs and notifications arrive
COMPANY_INBOX=

# ── Cloudflare Turnstile Bot Defense ─────────────────────────────────────────
# Free CAPTCHA alternative from Cloudflare Dashboard -> Turnstile
# Public site key for client widget rendering
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key for server-side token validation
TURNSTILE_SECRET_KEY=

# ── Application URL ──────────────────────────────────────────────────────────
# Public URL for canonical metadata and auth redirects
# Local development: http://localhost:3000
# Production: https://orvaneworks.vercel.app or your custom domain
NEXT_PUBLIC_APP_URL=
